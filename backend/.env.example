# MongoDB Atlas connection string (see backend/README.md for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/sankzytech?retryWrites=true&w=majority

# Shared key that authorizes access to the internal content management endpoints (/api/content).
# Pick any long random string — the admin page will ask for this same value.
ADMIN_KEY=change-me-to-a-long-random-string

# Port the server listens on locally
PORT=4000

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://sankzytech.vercel.app
