# MongoDB Atlas connection string (see backend/README.md for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/sankzytech?retryWrites=true&w=majority

# Password required to log into the content manager (admin.html).
# Pick any long random string.
ADMIN_KEY=change-me-to-a-long-random-string

# Secret used to SIGN the JWT issued after a successful login.
# Must be a different long random string from ADMIN_KEY, and must stay secret.
JWT_SECRET=change-me-to-a-different-long-random-string

# Port the server listens on locally
PORT=4000

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://sankzytech.vercel.app
